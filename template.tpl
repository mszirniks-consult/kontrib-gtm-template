___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// KONTRIB Tag als benutzerdefinierte Vorlage fuer den Google Tag Manager (Web-Container).
// Sandboxed JavaScript: kein new, kein this, keine Regex-Literale, kein try/catch, nur die require()-APIs des GTM.
// Ein Tag-Typ je Tag: init (Basis), pageview, event, conversion, consent, identify. Alle Aufrufe laufen ueber die
// Argument-Warteschlange window.aaq, die aa.js beim Laden uebernimmt (dasselbe Muster wie das Snippet).
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const copyFromWindow = require('copyFromWindow');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const getType = require('getType');
const logToConsole = require('logToConsole');

const CONSENT_KEYS = ['ad_storage', 'ad_user_data', 'ad_personalization', 'analytics_storage'];
// aa.js kommt fest von der KONTRIB-Plattformdomain (dieselbe Datei wie unter <Endpoint>/aa.js); die Daten gehen an den
// Endpoint des Mandanten. So braucht die Vorlage kein Skript-Recht mit Platzhalter-Host, das die Galerie nicht zulaesst.
const AA_JS = 'https://track.kontrib.io/aa.js';
const aa = createArgumentsQueue('aa', 'aaq');

function granted(v) {
  return v === true || v === 'true' || v === 'granted' || v === 1 || v === '1';
}

function text(v) {
  const t = getType(v);
  if (t === 'undefined' || t === 'null') return '';
  return makeString(v).trim();
}

function trimSlash(u) {
  let s = text(u);
  while (s.length && s.charAt(s.length - 1) === '/') s = s.slice(0, -1);
  return s;
}

function consentFromFields(prefix) {
  return {
    ad_storage: granted(data[prefix + 'AdStorage']),
    ad_user_data: granted(data[prefix + 'AdUserData']),
    ad_personalization: granted(data[prefix + 'AdPersonalization']),
    analytics_storage: granted(data[prefix + 'AnalyticsStorage']),
  };
}

function consentFromConsentMode() {
  const c = {};
  CONSENT_KEYS.forEach((k) => { c[k] = isConsentGranted(k) === true; });
  return c;
}

function consentDenied() {
  return { ad_storage: false, ad_user_data: false, ad_personalization: false, analytics_storage: false };
}

function propsFromTable(rows) {
  if (getType(rows) !== 'array' || rows.length === 0) return null;
  const o = {};
  let n = 0;
  rows.forEach((r) => {
    const k = text(r.key);
    if (!k) return;
    o[k] = r.value;
    n = n + 1;
  });
  return n ? o : null;
}

function fail(msg, value) {
  logToConsole('[KONTRIB] ' + msg, value);
  data.gtmOnFailure();
}

const type = data.tagType;

if (type === 'init') {
  const endpoint = trimSlash(data.endpoint);
  if (!endpoint || endpoint.indexOf('https://') !== 0) return fail('Endpoint fehlt oder ist nicht https:', data.endpoint);
  const source = data.consentSource || 'consent_mode';
  const consent = source === 'fields' ? consentFromFields('init') : source === 'consent_mode' ? consentFromConsentMode() : consentDenied();
  aa('init', { endpoint: endpoint, consent: consent, autoPageview: data.autoPageview !== false, debug: data.debug === true, source: 'gtm' });
  if (source === 'consent_mode') {
    CONSENT_KEYS.forEach((k) => {
      addConsentListener(k, (consentType, isGranted) => {
        const u = {};
        u[consentType] = isGranted === true;
        aa('consent', u);
      });
    });
  }
  if (copyFromWindow('__aa_loaded') === true) return data.gtmOnSuccess();
  injectScript(AA_JS, data.gtmOnSuccess, data.gtmOnFailure, 'kontrib-aa');
} else if (type === 'pageview') {
  aa('pageview');
  data.gtmOnSuccess();
} else if (type === 'event') {
  const name = text(data.eventName);
  if (!name) return fail('Ereignisname fehlt');
  aa('event', name, propsFromTable(data.eventProps));
  data.gtmOnSuccess();
} else if (type === 'conversion') {
  const o = {
    name: text(data.convName) || 'purchase',
    order_id: text(data.orderId) || null,
    value: null,
    currency: text(data.currency) || 'EUR',
    props: propsFromTable(data.convProps),
  };
  const raw = text(data.value);
  if (raw) {
    // Dezimaltrennzeichen: "129,90" und "1.234,56" (Komma = Dezimal) ebenso wie "129.90"
    const norm = raw.indexOf(',') >= 0 ? raw.split('.').join('').split(',').join('.') : raw;
    const n = makeNumber(norm);
    if (n === n) o.value = n;
  }
  const email = text(data.convEmail);
  if (email) o.email = email;
  aa('conversion', o);
  data.gtmOnSuccess();
} else if (type === 'consent') {
  aa('consent', consentFromFields('c'));
  data.gtmOnSuccess();
} else if (type === 'identify') {
  const email = text(data.identEmail);
  if (!email) return fail('E-Mail fehlt');
  aa('identify', { email: email });
  data.gtmOnSuccess();
} else {
  fail('Unbekannter Tag-Typ', type);
}


